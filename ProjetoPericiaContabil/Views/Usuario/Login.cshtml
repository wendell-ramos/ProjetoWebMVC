@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="auth-card">
    <div class="auth-brand">
        <span class="brand-mark" aria-hidden="true"><i class="bi bi-bank"></i></span>
        <h1>Per&iacute;cia Cont&aacute;bil</h1>
    </div>

    @if (ViewBag.Erro != null)
    {
        <div class="alert alert-danger" role="alert">@ViewBag.Erro</div>
    }

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Sucesso"]</div>
    }

    <form method="post" class="d-grid gap-3" aria-label="Formul&aacute;rio de login">
        <div>
            <label class="form-label" for="email">E-mail</label>
            <input class="form-control" type="email" id="email" name="email" placeholder="seuemail@exemplo.com" autocomplete="email" required />
        </div>

        <div>
            <label class="form-label" for="senha">Senha</label>
            <input class="form-control" type="password" id="senha" name="senha" placeholder="Digite sua senha" autocomplete="current-password" required />
        </div>

        <button type="submit" class="btn btn-primary w-100" aria-label="Entrar no sistema">
            <i class="bi bi-box-arrow-in-right"></i> Entrar
        </button>
    </form>

    <div class="auth-link">
        N&atilde;o tem conta?
        <a href="@Url.Action("Register", "Usuario")" aria-label="Ir para cadastro de usu&aacute;rio">Cadastrar</a>
    </div>
</section>
