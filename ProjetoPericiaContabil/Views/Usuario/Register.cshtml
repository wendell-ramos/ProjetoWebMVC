@model ProjetoPericiaContabil.Models.Usuario

@{
    ViewBag.Title = "Cadastro";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="auth-card">
    <div class="auth-brand">
        <span class="brand-mark" aria-hidden="true"><i class="bi bi-bank"></i></span>
        <h1>Criar Conta</h1>
        <p>Cadastre-se para solicitar e acompanhar suas atividades.</p>
    </div>

    @if (ViewBag.Erro != null)
    {
        <div class="alert alert-danger" role="alert">@ViewBag.Erro</div>
    }

    @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors", role = "alert" })

    @using (Html.BeginForm("Register", "Usuario", FormMethod.Post, new { @class = "d-grid gap-3", aria_label = "Formul\u00e1rio de cadastro" }))
    {
        <div>
            @Html.LabelFor(model => model.Nome, "Nome completo", new { @class = "form-label" })
            @Html.TextBoxFor(model => model.Nome, new { @class = "form-control", placeholder = "Seu nome completo", autocomplete = "name", required = "required" })
            @Html.ValidationMessageFor(model => model.Nome)
        </div>

        <div>
            @Html.LabelFor(model => model.Email, "E-mail", new { @class = "form-label" })
            @Html.TextBoxFor(model => model.Email, new { @class = "form-control", placeholder = "seuemail@exemplo.com", type = "email", autocomplete = "email", required = "required" })
            @Html.ValidationMessageFor(model => model.Email)
        </div>

        <div>
            @Html.LabelFor(model => model.Senha, "Senha", new { @class = "form-label" })
            @Html.PasswordFor(model => model.Senha, new { @class = "form-control", placeholder = "Crie uma senha segura", autocomplete = "new-password", required = "required" })
            @Html.ValidationMessageFor(model => model.Senha)
        </div>

        <button type="submit" class="btn btn-primary w-100" aria-label="Cadastrar novo usu&aacute;rio">
            <i class="bi bi-person-plus"></i> Cadastrar
        </button>
    }

    <div class="auth-link">
        J&aacute; tem conta?
        <a href="@Url.Action("Login", "Usuario")" aria-label="Ir para tela de login">Entrar</a>
    </div>
</section>
